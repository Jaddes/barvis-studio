# Kopirati u .env na serveru (chmod 600). .env se nikad ne commituje.

# Gmail: Google nalog -> Bezbednost -> Verifikacija u 2 koraka -> Lozinke za aplikacije
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
NOTIFY_TO=

# Sajtovi sa kojih forma sme da šalje (zarez između)
ALLOWED_ORIGINS=https://barvis-studio.dev

# Najviše RATE_LIMIT upita sa iste IP adrese u RATE_WINDOW sekundi
RATE_LIMIT=5
RATE_WINDOW=600

# Nasumičan niz; IP adrese se čuvaju samo kao heš. Napraviti sa: openssl rand -hex 16
IP_SALT=
